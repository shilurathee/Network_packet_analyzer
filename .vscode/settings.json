{
  "python.defaultInterpreterPath": "${default folder}.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "args": [
        "-ExecutionPolicy",
        "Bypass"
      ]
    }
  },
  "clangd.enableCodeCompletion": false
}